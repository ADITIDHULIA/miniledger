# Base URL of the MiniLedger API (no trailing slash).
# Physical phone:   http://<your-laptop-LAN-IP>:4000   (e.g. http://192.168.1.23:4000)
# Android emulator: http://10.0.2.2:4000
# iOS simulator:    http://localhost:4000
# If left empty, the app tries to derive your laptop's IP from the Expo dev server automatically.
EXPO_PUBLIC_API_URL=
